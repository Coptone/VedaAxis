{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedaaxis.dev/contracts/ai-candidate.schema.json",
  "title": "VedaAxis AI Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "basePlanId", "assignments", "reasons", "warnings", "confidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "candidateId": { "type": "string", "format": "uuid" },
    "basePlanId": { "type": ["string", "null"], "format": "uuid" },
    "assignments": {
      "type": "array",
      "items": { "$ref": "plan-snapshot.schema.json#/$defs/assignment" }
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "confidence": { "enum": ["UNVERIFIED", "RULE_VALIDATED"] },
    "provider": { "type": "string", "maxLength": 80 },
    "model": { "type": "string", "maxLength": 120 },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
